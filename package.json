{
  "name": "yu-law-ai-workbench",
  "version": "0.1.1",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:desktop:security": "node --test tests/desktop-security.test.mjs",
    "test:desktop:e2e": "node --test tests/desktop-safety-e2e.test.mjs",
    "test:desktop:providers": "node --test tests/desktop-safety-e2e.test.mjs",
    "test:desktop:shell": "python3 -m unittest discover -s tests_py -p 'test_*.py'",
    "test:desktop:runner": "node --test tests/desktop-runner.test.mjs",
    "test:desktop:recovery": "node --test tests/desktop-recovery.test.mjs",
    "test:desktop:release": "node desktop/credential-scan.mjs && node --test tests/desktop-release.test.mjs",
    "test:desktop:catalog": "node --test tests/tool-registry.test.mjs tests/desktop-catalog.test.mjs && python3 -m unittest tests_py.test_local_app.LocalAppTests.test_catalog_is_complete_and_runtime_status_is_truthful",
    "test:desktop:ui": "node --test tests/rendered-html.test.mjs tests/desktop-catalog.test.mjs && python3 -m unittest discover -s tests_py -p 'test_*.py'",
    "test:desktop:history": "python3 -m unittest tests_py.test_local_app.LocalAppTests.test_history_filter_retry_and_record_only_delete && node --test tests/desktop-history.test.mjs",
    "test:desktop:a11y": "node --test tests/desktop-a11y.test.mjs && python3 -m unittest discover -s tests_py -p 'test_*.py'",
    "typecheck": "tsc --noEmit",
    "build:desktop": "python3 -m compileall -q local_app && python3 desktop/verify-python-shell.py",
    "package:windows:verify": "python3 desktop/verify-python-shell.py",
    "start:desktop": "python3 -m local_app",
    "verify:desktop": "npm run build:desktop && npm run lint && node --test tests/*.test.mjs && npm run test:desktop:release",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
